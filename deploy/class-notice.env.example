CLASS_NOTICE_INSTANCE_PATH=/var/lib/class-notice
CLASS_NOTICE_PROXY_HOPS=1
# IP-only HTTP: 0. Change to 1 after HTTPS is configured and verified.
CLASS_NOTICE_SECURE_COOKIE=0
# Optional: override executable discovery for local Word-to-PDF previews.
# CLASS_NOTICE_SOFFICE=/usr/bin/libreoffice
# Optional: use a stable secret of at least 32 characters. If omitted, the app
# generates /var/lib/class-notice/secret_key once and keeps it across updates.
# CLASS_NOTICE_SECRET_KEY=replace-with-a-stable-random-secret
